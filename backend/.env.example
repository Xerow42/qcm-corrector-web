# Copy this file to .env (git-ignored) and fill in real values locally.
# Never commit a real .env file — see README.md > Security.

# PostgreSQL connection string.
DATABASE_URL=postgresql://postgres:changeme@localhost:5432/qcm_corrector

# Base URL of the AI grading service (see ../ai-service) and the path it
# exposes its analysis endpoint on.
IA_API_BASE_URL=http://127.0.0.1:8000
IA_ANALYZE_PATH=/analyze
IA_TIMEOUT_SECONDS=60

# SMTP account used to send result e-mails. Use an app password, never a
# real account password, and never commit real values here.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=qcm@example.com
SMTP_PASSWORD=changeme
SMTP_FROM=QCM Corrector <qcm@example.com>
SMTP_USE_TLS=true

# Base URL of the deployed web app, used when generating PDFs that render a
# live web page (see pdf_generator.py).
WEB_BASE_URL=http://localhost:3000

# Optional fallback password for professor creation. Set locally; never commit the real value.
DEFAULT_PROFESSOR_PASSWORD=
