# Copy this file to .env.local (git-ignored) and adjust the values.
#
# IMPORTANT: every NEXT_PUBLIC_* variable is embedded in the JavaScript sent to
# the browser. Never put a password, token or private key in this file.

# Base URL of the FastAPI backend (no trailing slash).
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# Optional demo values pre-filled in the "New MCQ" form.
# The e-mail must match a teacher that exists in your backend database.
NEXT_PUBLIC_DEMO_TEACHER_EMAIL=teacher@example.com
NEXT_PUBLIC_DEMO_TEACHER_ID=1
